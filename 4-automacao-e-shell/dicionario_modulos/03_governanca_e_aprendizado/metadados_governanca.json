      "comando": "bash -c 'SCRIPT=$(find \"$HOME/projetos\" -maxdepth 4 -name \"atualizar_sentinela.sh\" 2>/dev/null | head -n 1); [ -n \"$SCRIPT\" ] && bash \"$SCRIPT\" || bash ~/.gemini/config/atualizar_sentinela.sh'",
